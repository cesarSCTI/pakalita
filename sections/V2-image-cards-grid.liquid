{% comment %}
  Section: Image Cards Grid (Carousel)
  - Grid/carrusel de tarjetas con bloques reutilizables
  - Cada bloque: label, imagen y link
  - Control de fondo, padding y ancho (full-width / container)
  - Modo carrusel: muestra 3 tarjetas a la vez con navegación
{% endcomment %}

<section
  class="image-cards-grid"
  id="image-cards-grid-{{ section.id }}"
  style="
    background-color: {{ section.settings.bg_color }};
    background-image: {% if section.settings.bg_image %}url('{{ section.settings.bg_image | image_url }}'){% endif %};
    background-size: cover;
    background-position: center;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.padding_left }}px;
    padding-right: {{ section.settings.padding_right }}px;
  "
>
  <div class="image-cards-grid__wrapper" style="max-width: {% if section.settings.layout_width == 'full' %}100%{% else %}1360px{% endif %}; margin: 0 auto;">

    {% if section.settings.section_title != blank %}
      <div class="image-cards-grid__header">
        <h2 class="image-cards-grid__title">{{ section.settings.section_title }}</h2>
      </div>
    {% endif %}

    {% if section.settings.enable_carousel %}
      {%- assign total_blocks = section.blocks | size -%}
      <div class="image-cards-carousel" data-section-id="{{ section.id }}">

        <div class="image-cards-carousel__track-wrapper">
          <div class="image-cards-carousel__track" id="carousel-track-{{ section.id }}">
            {% for block in section.blocks %}
              <div class="image-cards-grid__card image-cards-carousel__slide" {{ block.shopify_attributes }}>
                <!---<a href="{{ block.settings.card_link }}" class="image-cards-grid__card-link">---></div>
                  
                  {% if block.settings.card_label != blank %}
                    <div class="image-cards-grid__label">
                      <span>
                          {{ block.settings.card_label }}
                      </span>
                    </div>
                  {% endif %}

                  {% if block.settings.card_image != blank %}
                    <div class="image-cards-grid__image-wrap">
                      {{ block.settings.card_image | image_url: width: 800 | image_tag: 
                        class: 'image-cards-grid__image',
                        alt: block.settings.card_label | default: shop.name | escape
                      }}
                    </div>
                  {% else %}
                    <div class="image-cards-grid__placeholder">
                      <svg class="placeholder-svg" viewBox="0 0 400 400">
                        <rect fill="#f2f2f2" width="400" height="400"/>
                        <text x="200" y="200" text-anchor="middle" dy=".3em" fill="#ccc" font-size="24">
                          Imagen no seleccionada
                        </text>
                      </svg>
                    </div>
                  {% endif %}
                  <div class="image-cards-grid_space"></div>

                <!---</a>--->
              </div>
            {% endfor %}
          </div>
        </div>

        <button class="image-cards-carousel__btn image-cards-carousel__btn--prev" id="carousel-prev-{{ section.id }}" aria-label="Anterior">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="image-cards-carousel__btn image-cards-carousel__btn--next" id="carousel-next-{{ section.id }}" aria-label="Siguiente">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M7.5 5L12.5 10L7.5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        {% if total_blocks > 3 %}
          <div class="image-cards-carousel__dots" id="carousel-dots-{{ section.id }}">
            {% assign dot_count = total_blocks | minus: 2 %}
            {% for i in (1..dot_count) %}
              <button class="image-cards-carousel__dot{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Ir a slide {{ forloop.index }}"></button>
            {% endfor %}
          </div>
        {% endif %}

      </div>

    {% else %}
      <div class="image-cards-grid__container">
        {% for block in section.blocks %}
          <div class="image-cards-grid__card" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.card_link }}" class="image-cards-grid__card-link">
              
              {% if block.settings.card_label != blank %}
                <div class="image-cards-grid__label">
                  <span>
                      {{ block.settings.card_label }}
                  </span>
                </div>
              {% endif %}

              {% if block.settings.card_image != blank %}
                <div class="image-cards-grid__image-wrap">
                  {{ block.settings.card_image | image_url: width: 800 | image_tag: 
                    class: 'image-cards-grid__image',
                    alt: block.settings.card_label | default: shop.name | escape
                  }}
                </div>
              {% else %}
                <div class="image-cards-grid__placeholder">
                  <svg class="placeholder-svg" viewBox="0 0 400 400">
                    <rect fill="#f2f2f2" width="400" height="400"/>
                    <text x="200" y="200" text-anchor="middle" dy=".3em" fill="#ccc" font-size="24">
                      Imagen no seleccionada
                    </text>
                  </svg>
                </div>
              {% endif %}
              <div class="image-cards-grid_space"></div>

            </a>
          </div>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

{% style %}

.image-cards-grid {
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.image-cards-grid__wrapper {
  padding: 0 1rem;
  box-sizing: border-box;
}

.image-cards-grid__header {
  text-align: center;
  margin-bottom: 2rem;
}

.image-cards-grid__title {
  margin: 0;
  font-size: 2rem;
  font-weight: 500;
  color: #111;
}

.image-cards-grid__container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
  width: 100%;
}

.image-cards-grid__card {
  position: relative;
  overflow: hidden;
  border-radius: 0.5rem;
  background: #fff;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.image-cards-grid__card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

.image-cards-grid__card-link {
  display: block;
  position: relative;
  text-decoration: none;
  color: inherit;
  overflow: hidden;
}

.image-cards-grid__label {
  top: 1rem;
  left: 1rem;
  z-index: 2;
  background: rgba(255, 255, 255, 0.95);
  padding: 15px;
  border-radius: 0.25rem;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: #111;
  backdrop-filter: blur(10px);
}
.image-cards-grid_space{
    height:30px;
}
.image-cards-grid__label span {
    background: #F5F5F5;
    padding: 5px 8px;
}
.image-cards-grid__image-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
  background: #fff;
  padding:0 15px;
}

.image-cards-grid__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform 0.4s ease;
}

.image-cards-grid__card:hover .image-cards-grid__image {
  transform: scale(1.05);
}

.image-cards-grid__placeholder {
  width: 100%;
  aspect-ratio: 1;
  background: #f2f2f2;
  border: 1px dashed #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  box-sizing: border-box;
}

.image-cards-grid__placeholder .placeholder-svg {
  width: 100%;
  height: 100%;
  opacity: 0.4;
}

/* ─── Carousel ─────────────────────────────────────────────── */

.image-cards-carousel {
  position: relative;
  width: 100%;
}

.image-cards-carousel__track-wrapper {
  overflow: hidden;
  width: 100%;
}

.image-cards-carousel__track {
  display: flex;
  gap: 1.5rem;
  transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  will-change: transform;
}

.image-cards-carousel__slide {
  flex: 0 0 calc((100% - 3rem) / 3);
  min-width: 0;
}

.image-cards-carousel__btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1px solid rgba(0, 0, 0, 0.12);
  background: #fff;
  color: #111;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  transition: background 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
}

.image-cards-carousel__btn:hover {
  background: #f5f5f5;
  box-shadow: 0 4px 16px rgba(0,0,0,0.15);
}

.image-cards-carousel__btn:disabled {
  opacity: 0.35;
  cursor: default;
  pointer-events: none;
}

.image-cards-carousel__btn--prev {
  left: -22px;
}

.image-cards-carousel__btn--next {
  right: -22px;
}

.image-cards-carousel__dots {
  display: flex;
  justify-content: center;
  gap: 0.5rem;
  margin-top: 1.5rem;
}

.image-cards-carousel__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  border: none;
  background: rgba(0,0,0,0.2);
  cursor: pointer;
  padding: 0;
  transition: background 0.25s ease, transform 0.25s ease;
}

.image-cards-carousel__dot.is-active {
  background: #111;
  transform: scale(1.3);
}

/* Responsive */
@media (max-width: 768px) {
  .image-cards-grid__container {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .image-cards-grid__title {
    font-size: 1.5rem;
  }

  .image-cards-grid__label {
    font-size: 0.65rem;
    padding: 0.3rem 0.6rem;
    top: 0.75rem;
    left: 0.75rem;
  }

  .image-cards-carousel__slide {
    flex: 0 0 calc((100% - 1rem) / 2);
  }

  .image-cards-carousel__btn--prev {
    left: -12px;
  }

  .image-cards-carousel__btn--next {
    right: -12px;
  }
}

@media (max-width: 480px) {
  .image-cards-grid__container {
    grid-template-columns: 1fr;
  }

  .image-cards-carousel__slide {
    flex: 0 0 85%;
  }
}

{% endstyle %}

<script>
(function() {
  var sectionId = '{{ section.id }}';
  var track = document.getElementById('carousel-track-' + sectionId);
  if (!track) return;

  var slides = track.querySelectorAll('.image-cards-carousel__slide');
  var btnPrev = document.getElementById('carousel-prev-' + sectionId);
  var btnNext = document.getElementById('carousel-next-' + sectionId);
  var dotsContainer = document.getElementById('carousel-dots-' + sectionId);
  var dots = dotsContainer ? dotsContainer.querySelectorAll('.image-cards-carousel__dot') : [];

  var currentIndex = 0;
  var slidesVisible = getSlidesVisible();
  var maxIndex = Math.max(0, slides.length - slidesVisible);

  function getSlidesVisible() {
    var w = window.innerWidth;
    if (w <= 480) return 1;
    if (w <= 768) return 2;
    return 3;
  }

  function getSlideWidth() {
    if (slides.length === 0) return 0;
    var style = window.getComputedStyle(track);
    var gap = parseFloat(style.gap) || 24;
    return slides[0].offsetWidth + gap;
  }

  function goTo(index) {
    slidesVisible = getSlidesVisible();
    maxIndex = Math.max(0, slides.length - slidesVisible);
    currentIndex = Math.max(0, Math.min(index, maxIndex));
    track.style.transform = 'translateX(-' + (currentIndex * getSlideWidth()) + 'px)';
    updateUI();
  }

  function updateUI() {
    if (btnPrev) btnPrev.disabled = currentIndex === 0;
    if (btnNext) btnNext.disabled = currentIndex >= maxIndex;
    dots.forEach(function(dot, i) {
      dot.classList.toggle('is-active', i === currentIndex);
    });
  }

  if (btnPrev) {
    btnPrev.addEventListener('click', function() { goTo(currentIndex - 1); });
  }
  if (btnNext) {
    btnNext.addEventListener('click', function() { goTo(currentIndex + 1); });
  }

  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      goTo(parseInt(dot.dataset.index, 10));
    });
  });

  /* Touch / swipe */
  var touchStartX = 0;
  var touchDeltaX = 0;
  track.addEventListener('touchstart', function(e) {
    touchStartX = e.touches[0].clientX;
    touchDeltaX = 0;
  }, { passive: true });
  track.addEventListener('touchmove', function(e) {
    touchDeltaX = e.touches[0].clientX - touchStartX;
  }, { passive: true });
  track.addEventListener('touchend', function() {
    if (Math.abs(touchDeltaX) > 50) {
      goTo(touchDeltaX < 0 ? currentIndex + 1 : currentIndex - 1);
    }
  });

  /* Recalculate on resize */
  window.addEventListener('resize', function() {
    var newVisible = getSlidesVisible();
    if (newVisible !== slidesVisible) {
      goTo(0);
    } else {
      goTo(currentIndex);
    }
  });

  goTo(0);
})();
</script>

{% schema %}
{
  "name": "V2 Image Cards Grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Título de la sección (opcional)",
      "default": "Nuestras Colecciones"
    },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "Activar modo carrusel",
      "default": true,
      "info": "Muestra las tarjetas en un carrusel con 3 visibles a la vez. Si se desactiva, se muestra el grid original."
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "Ancho del contenedor",
      "default": "container",
      "options": [
        {"value": "container", "label": "Ancho del contenedor"},
        {"value": "full", "label": "Ancho completo"}
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Imagen de fondo (opcional)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding izquierdo",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding derecho",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Tarjeta de imagen",
      "settings": [
        {
          "type": "text",
          "id": "card_label",
          "label": "Texto superior (badge)",
          "default": "Etiqueta"
        },
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Imagen de la tarjeta"
        },
        {
          "type": "url",
          "id": "card_link",
          "label": "Link de la tarjeta",
          "default": "/"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "V2 Image Cards Grid",
      "category": "Custom",
      "blocks": [
        {"type": "card", "settings": {"card_label": "COLECCIÓN 1"}},
        {"type": "card", "settings": {"card_label": "COLECCIÓN 2"}},
        {"type": "card", "settings": {"card_label": "COLECCIÓN 3"}}
      ]
    }
  ]
}
{% endschema %}
